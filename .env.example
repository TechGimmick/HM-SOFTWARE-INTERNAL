# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  SAFE TEMPLATE (committed to git, contains NO real secrets)
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────────────────────

# Flask secret key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-generated-secret-key-here

# PostgreSQL connection string (Supabase or any Postgres host)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Gmail SMTP — use an App Password (NOT your regular Gmail password)
# Generate at: https://myaccount.google.com → Security → App Passwords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
